shader_type spatial;
render_mode unshaded, cull_back;

uniform sampler2D albedo_texture : source_color;
uniform sampler2D emission_texture : source_color;
uniform bool has_albedo_texture = false;
uniform bool has_emission_texture = false;
uniform vec4 body_tint : source_color = vec4(1.0);
uniform vec4 shadow_tint : source_color = vec4(0.16, 0.20, 0.30, 1.0);
uniform vec4 rim_color : source_color = vec4(0.30, 0.78, 1.0, 1.0);
uniform float emission_strength : hint_range(0.0, 1.0) = 0.18;
uniform float rim_strength : hint_range(0.0, 1.0) = 0.26;

void fragment() {
	vec3 sampled_color = has_albedo_texture ? texture(albedo_texture, UV).rgb : vec3(1.0);
	vec3 sampled_emission = has_emission_texture ? texture(emission_texture, UV).rgb : vec3(0.0);
	float facing = clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0);
	float rim = pow(1.0 - facing, 2.35);
	float ndl = clamp(dot(normalize(NORMAL), normalize(vec3(-0.35, 0.72, 0.58))), 0.0, 1.0);
	float band = ndl > 0.66 ? 1.0 : (ndl > 0.28 ? 0.64 : 0.34);
	vec3 base = sampled_color * body_tint.rgb;
	vec3 toon = mix(base * shadow_tint.rgb, base, band);
	ALBEDO = toon + sampled_emission * emission_strength + rim_color.rgb * rim * rim_strength;
}
