			vfx_preview_root.add_child(slash_ring)
			vfx_preview_effect = slash_ring
			slash_ring.play_profile(PROFILE_SLASH_RING, {"target": target})
			vfx_status_label.text = "Playing: Boss Slash Ring profile"
		20, 21:
