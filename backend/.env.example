# Glory Backend 配置模板
#
# 用法：把这个文件复制成 backend/.env，然后填上真实的值。
#
#   cp backend/.env.example backend/.env
#
# .env 已经在 .gitignore 里，**永远不要提交它**。
# 这个 .example 文件只有键名、没有值，所以可以进 git。

# ── Supabase ──────────────────────────────────────────────────────────────
# 项目地址，形如 https://abcdefghijkl.supabase.co
# Supabase Dashboard → Project Settings → API
GLORY_SUPABASE_URL=

# 可下发到客户端的公开 key（publishable / anon）。
# 本后端用它做注册、登录这类公开操作。
# 它进 Godot 是安全的 —— 本来就是设计给公开客户端用的。
GLORY_SUPABASE_PUBLISHABLE_KEY=

# ⛔⛔ 服务端专用 key（secret / service_role）。它**绕过 RLS**。
#
#   ❌ 不准进 Godot 工程      ❌ 不准打进 APK
#   ❌ 不准提交到 git         ❌ 不准发给任何人
#
# 只能待在这台服务器上。泄露等于整个数据库对外开放。
GLORY_SUPABASE_SECRET_KEY=

# ── 数据库 ────────────────────────────────────────────────────────────────
# PostgreSQL 连接串。Dashboard 顶部 Connect 按钮里复制。
#
# ⚠️ 选 **Session pooler** 或 **Direct connection** 那条，
#    不要 Transaction pooler（端口 6543）—— 那个模式和连接池驱动的预编译语句冲突。
#    （代码里对 6543 有兜底，但还是选对的那条更省事。）
#
# 形如 postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# ⛔ 里面含数据库密码，与 secret key 同级：不进 Godot、不进 APK、不进 git。
GLORY_DATABASE_URL=

# ── 限流（可选，有默认值）──────────────────────────────────────────────────
# 按来源 IP 的滑动窗口。默认对账号创建收得紧：正常玩家一辈子只注册一次。
# 本机要连开多个测试账号时把第一个调大。
# GLORY_RATE_LIMIT_ANONYMOUS_PER_HOUR=10
# GLORY_RATE_LIMIT_REFRESH_PER_HOUR=120

# ── 运行环境 ───────────────────────────────────────────────────────────────
# dev | prod。dev 会开更啰嗦的日志与 /docs 交互文档。
GLORY_ENVIRONMENT=dev
