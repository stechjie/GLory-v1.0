# Glory Backend 配置模板
#
# 用法：把这个文件复制成 backend/.env，然后填上真实的值。
#
#   cp backend/.env.example backend/.env
#
# .env 已经在 .gitignore 里，**永远不要提交它**。
# 这个 .example 文件只有键名、没有值，所以可以进 git。

# ── Supabase ──────────────────────────────────────────────────────────────
# 项目地址，形如 https://abcdefghijkl.supabase.co
# Supabase Dashboard → Project Settings → API
GLORY_SUPABASE_URL=

# 可下发到客户端的公开 key（publishable / anon）。
# 本后端用它做注册、登录这类公开操作。
# 它进 Godot 是安全的 —— 本来就是设计给公开客户端用的。
GLORY_SUPABASE_PUBLISHABLE_KEY=

# ⛔⛔ 服务端专用 key（secret / service_role）。它**绕过 RLS**。
#
#   ❌ 不准进 Godot 工程      ❌ 不准打进 APK
#   ❌ 不准提交到 git         ❌ 不准发给任何人
#
# 只能待在这台服务器上。泄露等于整个数据库对外开放。
GLORY_SUPABASE_SECRET_KEY=

# ── 运行环境 ───────────────────────────────────────────────────────────────
# dev | prod。dev 会开更啰嗦的日志与 /docs 交互文档。
GLORY_ENVIRONMENT=dev
