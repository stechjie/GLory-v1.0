  "bash tools/model_refinement/build_dark_parts_all.sh <blender.exe> <project> <delivery>/source undead_poison undead_parasite undead_spike undead_bomb undead_titan undead_mother",
  "py -3 tools/model_refinement/dark_race_materials.py --race undead",
  "godot --headless --path . res://tools/dark_refinement_contract_check.tscn -- --race undead --require-integrated --out <report.json>"
 ],
