 "workflow": "docs/CODEX_MODEL_WORKFLOW.md section 10",
 "data_change": {
  "file": "data/units/race_units.json",
  "fields": "dark_* model -> res://assets/models/units/dark_refined/<id>/<id>_refined.tscn; dark_imp model_visual_scale 1 -> 0.85; no gameplay field changed",
  "rollback": "set each dark_* model back to units.<id>.original below and dark_imp model_visual_scale back to 1; the original wrappers and their files are untouched (hash-verified by the contract check)"
 },
 "delivery": "assets/models/units/* is git-ignored; .gitignore re-includes dark_refined/ (and undead_refined/), so they ship with the code and need no git add -f. assets.manifest.json / assets.bundle.json are intentionally NOT updated (see pending).",
 "pending_asset_baseline": "The removed files are still listed in assets.manifest.json and inside the current asset ZIP, so asset_delivery_check reports them missing and restore_assets.ps1 would bring them back. Re-baselining (tools/update_asset_manifest.ps1 then tools/package_assets.ps1) also absorbs 19 unrelated pre-existing size mismatches (BGM mp3s, a UI png, DarkQueenAnimated.gd) and is the asset owner's decision.",
 "reproduce": [
  "godot --headless --path . --script res://tools/model_refinement/export_unit_reference.gd -- --model <wrapper> --unit-id <id> --out <delivery>/source/<id>",
  "py -3 tools/model_refinement/dark_race_textures.py --refs <delivery>/source",
  "bash tools/model_refinement/build_dark_parts_all.sh <blender.exe> <project> <delivery>/source",
  "py -3 tools/model_refinement/dark_race_materials.py",
  "godot --headless --path . res://tools/dark_refinement_contract_check.tscn -- --require-integrated --out <report.json>"
 ],
