static func localize(message: String, locale: String) -> String:
	if not locale.begins_with("en"):
		return message
	if EN.has(message):
		return str(EN[message])
	# Some endpoints substitute cooldown seconds into a localized template.
	for template: String in EN:
		if not template.contains("%d") and not template.contains("%s"):
			continue
		var parts := template.split("%d" if template.contains("%d") else "%s")
		if parts.size() == 2 and message.begins_with(parts[0]) and message.ends_with(parts[1]):
			var value := message.substr(parts[0].length(), message.length() - parts[0].length() - parts[1].length())
			return str(EN[template]).replace("%d", value).replace("%s", value)
	return message
