  "atomic_migration": {
    "rule": "Per visual, emitting the event, routing it through the Director and disabling the matching legacy diff branch must all happen in the same step. Adding events while the diff branch still fires would play every effect twice.",
    "enforced_by": "a single whitelist read by both LegacyBattleVfxAdapter and BattleVfx",
    "legacy_branches_gated": [
      "BattleVfx._collect_attack_events (diff-driven melee/ranged swing)",
