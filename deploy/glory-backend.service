[Unit]
Description=Glory Account Backend (FastAPI)
Documentation=https://github.com/stechjie/GLory-v1.0/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

# 专用低权限用户。**不要用 root 跑** —— 这个进程持有 Supabase 的 secret key
# 与数据库密码，一旦被攻破，以 root 身份跑等于把整台机器一起交出去。
User=glory
Group=glory

WorkingDirectory=/opt/glory/repo/backend

# 密钥从这里读，不写进 unit 文件（unit 文件是世界可读的）。
# 这个文件必须 chmod 600 且属主是 glory。
EnvironmentFile=/opt/glory/backend.env

# 同时在线上限的热改文件（backend/app/admission.py）。内容形如 {"online_limit": 400}，
# 改完 5 秒内生效，**不要为了改上限去重启** —— 重启会清空排队顺序。
# 文件不存在 = 用默认值（GLORY_ONLINE_LIMIT，没设就是 1000）。它不是密钥，可以 644。
Environment=GLORY_ADMISSION_FILE=/opt/glory/admission.json

# 出战名片的签名私钥（backend/app/loadout.py）。用 deploy/make_battle_card_key.py 生成，
# **必须 chmod 600、属主 glory**，和 backend.env 同一待遇。
# 文件不存在 = 发名片的接口回 503（玩家开不了新对局），但进程照常起来。
# 这把可以重新生成（轮换），与战斗服务器那把不可重生成的 DTLS 私钥是两回事。
Environment=GLORY_BATTLE_CARD_KEY_FILE=/opt/glory/battle_card_key.pem

# 战报的验章**公钥**（backend/app/battle_report.py）。注意是**公钥**，方向与上面那把相反：
# 战报由战斗服务器用它的私钥签，这边只验。所以这个文件不保密（644 即可），
# 被拿下也伪造不了战报。生成工具 deploy/make_battle_report_key.py。
# 文件不存在 = 交战报的接口回 503，**对局照常，只是不记历史**（docs/排位系统设计.md 第七节）。
# 按 mtime 热加载：轮换时换文件即可，不用重启。
Environment=GLORY_BATTLE_REPORT_PUBLIC_KEY_FILE=/opt/glory/battle_report_public.pem

# 公告图片（backend/app/announcements.py）。systemd 建目录 /var/lib/glory-media、属主 glory、
# 权限 755；下面 ProtectSystem=strict + ReadWritePaths= 空着时，这是本进程**唯一**能写的地方。
# Caddy 直接从这个目录给 /media/*（deploy/Caddyfile），两处路径必须一致（有测试钉着）。
StateDirectory=glory-media
Environment=GLORY_MEDIA_DIR=/var/lib/glory-media

# ⚠️ **只监听 127.0.0.1，绝不监听 0.0.0.0。**
#
# 对外由 Caddy 反向代理并终结 TLS。直接对外监听等于开了一个明文 HTTP 端口，
# 任何人都能绕过 HTTPS 直连它 —— 而这条链路上跑的是账号凭证。
# 改这一行前先想清楚。
# 解释器在 /opt/glory/venv，**不在**代码目录里 —— 代码目录归 root 只读，
# 而 pip 要写，所以分开放（见 deploy/bootstrap.sh 的 5/8 步）。
# 这两处路径必须一致；bootstrap 装完会校验一次，不一致就报错，
# 免得再出现「服务起不来但看不出为什么」。
ExecStart=/opt/glory/venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 --port 8099 --workers 1

# 单 worker 是刻意的：限流计数在进程内存里（见 backend/app/rate_limit.py），
# 多 worker 会让实际额度按 worker 数翻倍。要加 worker 必须先把限流换成
# Redis 或挪到代理层。
#
# 单进程的吞吐对现阶段绰绰有余 —— 登录是每个玩家一天几次的操作，
# 不是每帧都在打的接口。

Restart=on-failure
RestartSec=5s
# 反复崩溃时不要无限重启刷日志：10 分钟内超过 5 次就停下，等人来看。
StartLimitIntervalSec=600
StartLimitBurst=5

# --- 加固 ---------------------------------------------------------------
# 这个进程只需要读自己的代码、连出去打网络。别的一概不给。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 不给写任何地方。日志走 journald，不落文件。
ReadWritePaths=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=glory-backend

[Install]
WantedBy=multi-user.target
