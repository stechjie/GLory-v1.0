# Caddy 配置：TLS 终结 + 反向代理到账号后端。
#
# 为什么用 Caddy 而不是 nginx：证书**全自动**。它自己去 Let's Encrypt 申请、
# 自己续期，你完全不用管证书过期这件事。nginx 要另外配 certbot 和续期定时任务，
# 而"忘了续期导致全体玩家登不上"是这类系统最常见的事故之一。
#
# 装到 /etc/caddy/Caddyfile，然后 `sudo systemctl reload caddy`。
# ⚠️ deploy/update.sh **不会**替你更新这个文件（只有首次安装的 bootstrap.sh 写过一次）。
#    改了这里要手动装一次，命令见 deploy/README.md「公告」一节。

# ⚠️ 把下面这一行换成你的真实域名。
# DuckDNS 的话形如 glorytd-api.duckdns.org；换正式域名时也只改这里，
# 以及客户端的 AccountConfig.DEFAULT_BACKEND_URL。
GLORY_API_DOMAIN_PLACEHOLDER {

	# 维护公告（docs/公告系统设计.md）。**由 Caddy 直接给，不经过后端** ——
	# 它存在的全部意义就是账号服务器停了的时候也读得到。
	# 文件由管理员写：sudo tee /opt/glory/public/status.json。没有这个文件 = 404 = 没在维护。
	handle /status.json {
		root * /opt/glory/public
		header Cache-Control "no-store"
		file_server
	}

	# 公告图片。后端取回、检查过的文件，名字就是内容的 SHA-256，永远不变，所以可以永久缓存。
	# 目录由 glory-backend.service 的 StateDirectory 建（两处路径有测试钉着）。
	# 没有 browse：不列目录。
	handle_path /media/* {
		root * /var/lib/glory-media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# 后端只监听 127.0.0.1（见 glory-backend.service），所以外面进不来，
		# 必须从这里过。
		reverse_proxy 127.0.0.1:8099 {
			# 后端靠这个拿真实来源 IP 做限流。
			#
			# 这里是**覆盖**不是追加（追加要写 `header_up +X-Forwarded-For`）——
			# 玩家自己在请求里塞的假值会在这一层被直接丢掉。
			# 后端再确认一次请求确实来自本机回环才采信，见 routes/auth.py
			# 的 _client_ip()。两层加起来，伪造这个头没有意义。
			#
			# ⚠️ 若以后在 Caddy 前面再加一层（Cloudflare 之类），这个头会变成
			# 一串 IP，后端取第一段的做法要重新评估 —— 先看 _client_ip() 的注释。
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 安全响应头。这是个纯 JSON API，不该被当网页嵌进别的站点。
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# 别把服务器软件版本白送出去。
		-Server
	}

	# 请求日志。出问题时要能看到是谁在什么时候打了什么。
	# ⚠️ 只记路径与状态码，**不记请求体** —— 请求体里有 refresh token。
	log {
		output file /var/log/caddy/glory-api.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}

# 语音服务器（docs/语音LiveKit方案.md、deploy/livekit/README.md）。它的站点写在单独的文件里，
# 由 deploy/livekit/install_livekit.sh 生成。没装语音时这个文件不存在：import 用的是通配符，
# 匹配不到文件时 Caddy 只打一条警告、照常启动（写死文件名的话会直接起不来）。
import /etc/caddy/glory-voice*.caddy
