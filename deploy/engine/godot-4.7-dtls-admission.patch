+// GLory: classify only NEW UDP endpoints, before allocating a DTLS session.
+// This is not certificate or ClientHello validation; mbedTLS still does both.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+inline bool glory_dtls_can_start(const uint8_t *data, size_t size) {
+    // DTLS 1.0/1.2 record header: content type, version, epoch, sequence, length.
+    // Initial handshake record must be epoch 0 and start a ClientHello (type 1).
+    // Do not constrain sequence, fragmentation or cookie: mbedTLS handles them.
+    return size >= 14 && data[0] == 22 && data[1] == 0xfe &&
+            (data[2] == 0xfd || data[2] == 0xff) &&
+            data[3] == 0 && data[4] == 0 && data[13] == 1;
+}
