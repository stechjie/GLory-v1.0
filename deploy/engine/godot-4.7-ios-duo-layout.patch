+
+- (instancetype)initWithGameView:(GDTView *)gameView {
+	self = [super initWithFrame:CGRectZero];
+	if (self) {
+		self.gameView = gameView;
+		self.backgroundColor = UIColor.blackColor;
+		self.clipsToBounds = YES;
+		gameView.clipsToBounds = YES;
