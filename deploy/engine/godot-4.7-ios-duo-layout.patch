+// GLory iOS adaptive geometry. Pure C++17; UIKit supplies all coordinates in points.
+// No device identifiers, screen dimensions or duplicated reserved-region margins.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace GloryIOSGeometry {
+struct Rect {
+	double x = 0, y = 0, width = 0, height = 0;
+	double right() const { return x + width; }
+	double bottom() const { return y + height; }
+	bool finite() const {
+		return std::isfinite(x) && std::isfinite(y) && std::isfinite(width) &&
+				std::isfinite(height) && std::isfinite(right()) && std::isfinite(bottom());
+	}
+	bool empty() const { return !finite() || width <= 0 || height <= 0; }
+	double area() const { return empty() ? 0 : width * height; }
+};
+struct Insets { double top = 0, right = 0, bottom = 0, left = 0; };
+
+inline Rect intersection(const Rect &a, const Rect &b) {
+	if (a.empty() || b.empty()) return {};
+	const double x = std::max(a.x, b.x), y = std::max(a.y, b.y);
+	const double r = std::min(a.right(), b.right()), d = std::min(a.bottom(), b.bottom());
+	return r > x && d > y ? Rect{x, y, r - x, d - y} : Rect{};
+}
+
+inline Rect inward_pixels(const Rect &r, double scale) {
+	if (r.empty() || !std::isfinite(scale) || scale <= 0) return {};
+	const double x = std::ceil(r.x * scale) / scale;
+	const double y = std::ceil(r.y * scale) / scale;
+	const double right = std::floor(r.right() * scale) / scale;
+	const double bottom = std::floor(r.bottom() * scale) / scale;
+	return right > x && bottom > y ? Rect{x, y, right - x, bottom - y} : Rect{};
+}
+
+inline bool contains_center(const Rect &r, const Rect &previous) {
+	if (r.empty() || previous.empty()) return false;
+	const double x = previous.x + previous.width * 0.5;
+	const double y = previous.y + previous.height * 0.5;
+	return x >= r.x && x < r.right() && y >= r.y && y < r.bottom();
+}
+
+// Largest rectangular usable region. Enumerate horizontal boundaries and merge
+// blocked vertical intervals: O(n^3 log n), with no exponential rectangle growth.
+// Equal-size choices retain the previous pane; otherwise prefer the larger pane.
+inline Rect choose(const Rect &bounds, const Insets &insets,
+		const std::vector<Rect> &reserved, double scale, const Rect &previous = {}) {
+	if (bounds.empty() || !std::isfinite(scale) || scale <= 0 ||
+			!std::isfinite(insets.top) || !std::isfinite(insets.right) ||
+			!std::isfinite(insets.bottom) || !std::isfinite(insets.left)) return {};
+	const double x = bounds.x + std::max(0.0, insets.left);
+	const double y = bounds.y + std::max(0.0, insets.top);
+	Rect safe{x, y, bounds.right() - std::max(0.0, insets.right) - x,
+		bounds.bottom() - std::max(0.0, insets.bottom) - y};
+	safe = inward_pixels(intersection(safe, bounds), scale);
+	if (safe.empty()) return {};
+	std::vector<Rect> obstacles;
+	std::vector<double> edges{safe.x, safe.right()};
+	for (const Rect &region : reserved) {
+		// An invalid active region is unknown availability, not permission to draw.
+		if (!region.finite() || region.width < 0 || region.height < 0) return {};
+		const Rect clipped = intersection(safe, region);
+		if (clipped.empty()) continue;
+		obstacles.push_back(clipped);
+		edges.push_back(clipped.x);
+		edges.push_back(clipped.right());
+	}
+	if (obstacles.empty()) return safe;
+	std::sort(edges.begin(), edges.end());
+	edges.erase(std::unique(edges.begin(), edges.end()), edges.end());
+	Rect best;
+	auto consider = [&](Rect candidate) {
+		candidate = inward_pixels(candidate, scale);
+		if (candidate.empty()) return;
+		for (const Rect &blocked : obstacles) {
+			if (!intersection(candidate, blocked).empty()) return;
+		}
+		const double candidate_area = candidate.area(), best_area = best.area();
+		if (candidate_area > best_area ||
+				(candidate_area == best_area && contains_center(candidate, previous) &&
+						!contains_center(best, previous))) {
+			best = candidate;
+		}
+	};
+	for (size_t left = 0; left + 1 < edges.size(); ++left) {
+		for (size_t right = left + 1; right < edges.size(); ++right) {
+			const double x0 = edges[left], x1 = edges[right];
+			std::vector<std::pair<double, double>> blocked_y;
+			for (const Rect &obstacle : obstacles) {
+				if (obstacle.x < x1 && obstacle.right() > x0) {
+					blocked_y.emplace_back(obstacle.y, obstacle.bottom());
+				}
+			}
+			std::sort(blocked_y.begin(), blocked_y.end());
+			double cursor = safe.y;
+			for (const auto &interval : blocked_y) {
+				if (interval.first > cursor) {
+					consider({x0, cursor, x1 - x0, interval.first - cursor});
+				}
+				cursor = std::max(cursor, interval.second);
+			}
+			if (cursor < safe.bottom()) {
+				consider({x0, cursor, x1 - x0, safe.bottom() - cursor});
+			}
+		}
+	}
+	return best;
+}
+} // namespace GloryIOSGeometry
