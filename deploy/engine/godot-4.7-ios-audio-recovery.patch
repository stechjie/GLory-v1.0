+void AudioDriverCoreAudio::recover_output_if_stalled() {
+	if (!audio_unit || recovery_attempts >= 6) {
+		return;
+	}
+	const uint64_t now = OS::get_singleton()->get_ticks_usec();
+	if (now < recovery_check_after || get_time_since_last_mix() < 0.25) {
+		return;
+	}
+	// RemoteIO may report success but stop invoking its render callback after
+	// an interruption or another engine reconfigures the shared audio session.
+	// Only called while foreground and focused. Do not hold the mixer mutex
+	// across stop: an in-flight render callback may need it.
+	recovery_check_after = now + 1000000;
+	recovery_attempts++;
+	NSError *error = nil;
+	if (![[AVAudioSession sharedInstance] setActive:YES error:&error]) {
+		NSLog(@"[GLORY_AUDIO_DRIVER] activate failed: %@", error);
+		return;
+	}
+	const OSStatus stopped = AudioOutputUnitStop(audio_unit);
+	active = false;
+	const OSStatus uninitialized = AudioUnitUninitialize(audio_unit);
+	const OSStatus initialized = AudioUnitInitialize(audio_unit);
+	const OSStatus started = initialized == noErr ? AudioOutputUnitStart(audio_unit) : initialized;
+	active = started == noErr;
+	NSLog(@"[GLORY_AUDIO_DRIVER] recovery=%u stop=%d uninit=%d init=%d start=%d elapsed_ms=%.1f", recovery_attempts,
+		(int)stopped, (int)uninitialized, (int)initialized, (int)started,
+		(double)(OS::get_singleton()->get_ticks_usec() - now) / 1000.0);
+}
