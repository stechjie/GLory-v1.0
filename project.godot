; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5

[application]

config/name="Glory Beta 0.04"
run/main_scene="res://scenes/bootstrap/Bootstrap.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.113725, 0.14902, 0.2, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://ui/branding/glory_bootstrap.png"
config/icon="res://icon.svg"

[autoload]

StartupTrace="*res://scripts/autoload/StartupTrace.gd"
LocaleManager="*res://scripts/autoload/LocaleManager.gd"
GameState="*res://scripts/autoload/GameState.gd"
DataRegistry="*res://scripts/autoload/DataRegistry.gd"
PlayerProfile="*res://scripts/autoload/PlayerProfile.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AccountManager="*res://scripts/autoload/AccountManager.gd"
NetworkService="*res://scripts/autoload/NetworkService.gd"
RealtimeService="*res://scripts/autoload/RealtimeService.gd"
ChatService="*res://scripts/autoload/ChatService.gd"
RngService="*res://scripts/autoload/RngService.gd"
VFXManager="*res://effects/VFXManager.gd"
TutorialMode="*res://scripts/tutorial/TutorialMode.gd"
PerfLog="*res://scripts/autoload/PerfLog.gd"
DeviceHarness="*res://scripts/autoload/DeviceHarness.gd"
IssueReport="*res://scripts/autoload/IssueReport.gd"
ModalStack="*res://ui/services/ModalStack.gd"
DialogService="*res://ui/services/DialogService.gd"
AsyncActionController="*res://ui/controllers/AsyncActionController.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
