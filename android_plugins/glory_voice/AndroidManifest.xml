<?xml version="1.0" encoding="utf-8"?>
<!--
  GloryVoice: voice echo validation plugin (docs/聊天系统设计.md section 9, option 2).

  uses-sdk with an explicit targetSdkVersion is required: a library manifest without one
  makes the manifest merger add legacy implied permissions (READ_PHONE_STATE,
  WRITE_EXTERNAL_STORAGE) to the whole app.

  The meta-data name is how Godot 4 (plugin v2) finds the plugin class at startup.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.glory.voice">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.GloryVoice"
            android:value="com.glory.voice.GloryVoicePlugin" />
    </application>
</manifest>
