# Godot 4 cache and imported assets
.godot/

# Export presets (contains release keystore password — share privately, never commit)
export_presets.cfg
# Godot 4 把签名密码与脚本加密密钥存在这里 —— 绝不能提交
export_credentials.cfg
# 签名文件本身（现在放在仓库外，这两条只是防止有人拷进来）
*.keystore
*.jks

# Android build template (regenerated by Godot editor: Project > Install Android Build Template)
android/

# Art/audio assets (~3.1GB — too large for GitHub; shared separately via cloud drive)
# 必须带前导斜杠：只忽略根目录美术。不带斜杠会匹配任意层级的 assets 目录，
# 曾误伤 scripts/assets（BattleAssetManifest/Service）导致代码文件从未进 git。
#
# Trailing /* is required, not /assets/ — git never descends into an excluded
# directory, so once the parent is excluded any "!" re-include below is dead.
/assets/*

# Ship the Queen normal repair with code. Distinct *_smooth.fbx filenames keep
# the older cloud asset overlay from replacing the corrected geometry.
!/assets/models/
/assets/models/*
!/assets/models/units/
/assets/models/units/*
!/assets/models/units/dark_queen_animated/
/assets/models/units/dark_queen_animated/*
!/assets/models/units/dark_queen_animated/DarkQueenAnimated.gd
!/assets/models/units/dark_queen_animated/DarkQueenAnimated.gd.uid
!/assets/models/units/dark_queen_animated/dark_queen_animated.tscn
!/assets/models/units/dark_queen_animated/dark_queen_idle_smooth.fbx
!/assets/models/units/dark_queen_animated/dark_queen_idle_smooth.fbx.import
!/assets/models/units/dark_queen_animated/dark_queen_attack_smooth.fbx
!/assets/models/units/dark_queen_animated/dark_queen_attack_smooth.fbx.import
!/assets/models/units/dark_queen_animated/dark_queen_run_smooth.fbx
!/assets/models/units/dark_queen_animated/dark_queen_run_smooth.fbx.import

# Exception: VFX textures must ship through git. effects/ holds ~1080 references
# to res://assets/vfx/, so a teammate without these files hits
# "Failed loading resource" the moment a battle starts.
!/assets/vfx/

# Same reason — procedural VFX shaders sample these (348KB total).
!/assets/vfx_textures/

# Single UI texture that VFXSummonSpawn3D.gd preload()s. preload is a
# compile-time dependency: without the file the whole script fails to load,
# not just the effect. Re-including one file needs every parent directory
# walked back in, hence the alternating !dir / dir/* pairs below.
!/assets/ui/
/assets/ui/*
!/assets/ui/buttons/
/assets/ui/buttons/*
!/assets/ui/buttons/ready_magic_circle.png
!/assets/ui/buttons/ready_magic_circle.png.import

# Runtime logs
logs/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Godot 在 Windows 上运行时生成、用完即删的插件 dll 临时副本（~ 开头）。
# ~libeffekseer.x86_64.dll 曾被误提交（6ba77d4 删掉），之后每次跑游戏都会冒成未跟踪文件。
~*.dll
# 同一类：Windows 替换正在使用的 dll 时留下的 ~xxx.dll~RFxxxx.TMP。
~*.TMP

# Claude Code local settings
.claude/settings.local.json

# 截帧输出（体积大，可随时重新生成）
captures/

# tools/run_check.ps1 的原始日志与结构化结果。每次运行都会重写，是证据不是源码。
reports/

# 出包时由 tools/android_smoke.sh 生成并打进 APK 的构建身份。生成物，不是源码；
# 桌面/编辑器运行时它不存在是正常的（StartupTrace 会如实报 available=false）。
build_info.json
__pycache__/

# Written and removed by tools/promo_capture.ps1 to force the movie-recording
# viewport size. If a crash leaves one behind, deleting it is always safe.
override.cfg

# A5：283 MB 的历史备份不进运行仓库。需要时从工件库取回，不要提交。
backups/

# 私有凭据，不进仓库
upload ssh code.txt

# ── 审计证据与改动前备份：留在本地/工件库，不进运行仓库 ──
# 依据：全部带 .gdignore（Godot 完全跳过）+ 全仓库零 res:// 引用 + 导出不含。
# 参见 docs/GLORY_V2_白模与真机复审优化清单_20260822.md:458
# 例外：A4_device_battle_20260820/ 必须继续跟踪 ——
#       tools/battle_frame_time_check.gd 读它的 summary.json 当帧时间基线。
/A4_android_smoke_20260820/
/A4_prechange_backup_20260820/
/A5_asset_and_license_20260820/
/A5_prechange_backup_20260820/
/B4_prechange_backup_20260819/
/B4_vfx_budget_20260819/
/B5_prechange_backup_20260820/
/B5_review_compare_20260820/
/D3_battle_presentation_actors_20260819/
/D3_prechange_backup_20260819/
/D4_battle_presentation_basic_attack_20260819/
/D4_prechange_backup_20260819/
/D5_battle_presentation_feel_20260819/
/D5_prechange_backup_20260819/
/D6_battle_presentation_cleanup_20260819/
/D6_prechange_backup_20260819/
/E3_prechange_backup_20260819/
/E3_startup_warmup_20260819/

# 服务器包由 make_server_zip.ps1 生成，是构建产物不是源码。
# **用通配符，不要写死协议号** —— 包名跟着协议号走（glory_server_p<N>.zip），
# 写死 p17 的话，顶号到 p19 之后新包就不在忽略范围内了，
# 然后某次 `git add -A` 会把一个 4.8 MB 的构建产物提交进仓库。
/glory_server_p*.zip

# 本机的 Godot console 版路径。每台机器不一样，所以不进 git ——
# make_server_zip.ps1 会读它，读不到就自动扫描（见 Resolve-Godot）。
/tools/godot_path.txt
/glory_server_upload*.zip

# ── Glory Backend（FastAPI）──
# 真实密钥。模板是 backend/.env.example（只有键名），那个进 git。
backend/.env
# 虚拟环境是本机产物，用 requirements.txt 重建
backend/.venv/
.pytest_cache/

# ── 战斗服务器的 DTLS 私钥（C14）──
# 默认在 user://（AppData），本来就不在仓库树里；这几条是防御性的 ——
# 有人用 --tls-key=./xxx.pem 把它指到仓库里时挡一道。
# 配对的**证书**是公开的，在 scripts/multiplayer/NetTLSCert.gd 里，那个要进 git。
*_key.pem
glory_server_key*.pem
/certs/
