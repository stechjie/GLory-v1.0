  "defects_found_and_fixed": [
    {
      "what": "attack_start / projectile_spawn / impact defaulted to ambient priority.",
      "why_it_mattered": "BattlePresentationEvent._default_visibility() was written in D1, before those types existed, so they fell through to ambient. They were therefore exposed to ambient merging, were not treated as blocking by has_blocking_cues(), and would be dropped during DRAINING. Checklist section 3 lists them as important, with a crit impact being critical.",
      "effect": "Round 2 of the slice sample went from 39 merged cues to 0 merged, 20 degraded."
    },
    {
      "what": "Ambient merging ran unconditionally instead of only on overflow.",
      "why_it_mattered": "Checklist 4.4 allows merging when events overflow. Merging while there is budget left hides damage numbers for no reason."
    },
    {
      "what": "The ambient merge window matched a cue against itself.",
      "why_it_mattered": "The key was recorded before the redundancy test, so the first cue for a target always looked like a repeat. Now only a cue that actually started is recorded."
    },
    {
      "what": "Live cue counts never decremented on the inline-completion and adapter-rejected paths.",
      "why_it_mattered": "The counter could only grow, which would eventually make every cue look over budget."
    },
    {
      "what": "cue_play_basic_attack did not carry the human_king and mirror_clone special cases the batched diff helpers had.",
      "why_it_mattered": "Widening the slice to every unit would have given those units an extra swing the legacy path deliberately omits."
    }
  ],
